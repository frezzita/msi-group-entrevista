APP_NAME="MSI Group"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Argentina/Buenos_Aires

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_AR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=msi_reservas
DB_USERNAME=msi
DB_PASSWORD=msi

# La disponibilidad se cachea via el facade Cache: cualquier store sirve.
# redis es el recomendado (cache en memoria); si no tenes Redis, usa "database" o "file".
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
MAIL_MAILER=log
